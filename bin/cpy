#!/usr/bin/env bash

set -euo pipefail

die() {
  echo "$1" 1>&2
  exit 1
}

if command -v pbcopy > /dev/null; then
  pbcopy
elif command -v xclip > /dev/null; then
  xclip -selection clipboard
elif command -v copy.exe > /dev/null; then
  die "copy.exe found but is not supported"
else
  die "No copier found!"
fi
