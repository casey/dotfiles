setopt local_options err_return nounset

local branch=`git branch --show-current`
local main=`git worktree list --porcelain | head -1 | cut -d' ' -f2`
local worktree=`git rev-parse --show-toplevel`

if [[ -e $worktree/notes.md ]]; then
  echo "gwd: refusing to remove worktree containing notes.md" >&2
  return 1
fi

cd $main

git worktree remove $worktree

if ! is-git-worktree-dirty && ! is-git-staged-changes && ! is-git-untracked-files; then
  git pull --ff-only
fi

git branch -d $branch
