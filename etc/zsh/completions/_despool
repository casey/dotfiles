#compdef despool

local repo=~/src/cubby

[[ -d $repo ]] || return 1

local offset=0

if [[ ${words[2]} == (-c|--clipboard) ]]; then
  offset=1
fi

if (( CURRENT == 2 + offset )); then
  local expl
  local -a names
  names=(${(f)"$(git -C $repo -c core.quotePath=false ls-tree -r --name-only @{upstream} 2> /dev/null)"})

  _wanted cubby-files expl 'cubby file' _multi_parts -f / names
elif (( CURRENT == 3 && offset == 0 )); then
  _alternative \
    'files:destination:_files' \
    'stdout:standard output:(-)'
fi
